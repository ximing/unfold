# Unfold server 环境变量（示例）。真实值见本目录 .env（不入库）。
DATABASE_URL=postgres://USER:PASS@127.0.0.1:5432/unfold_dev

SESSION_SECRET=
UNFOLD_ENV=development

# 本地种子账号。密码留空，不要写入真实口令。
SEED_USERNAME=unfold
SEED_PASSWORD=

# 图片文件目录。未设置时用 apps/server/data/assets
ASSET_DIR=

ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_IS_PUBLIC=false
ATTACHMENT_S3_FORCE_PATH_STYLE=true
