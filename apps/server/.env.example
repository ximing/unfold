# Unfold server 环境变量（示例）。真实值见本目录 .env（不入库）。
# dev/test 同库（用户明确要求）；prod 用 unfold_prod。
DATABASE_URL=postgres://USER:PASS@222.128.65.91:25432/unfold_dev
DATABASE_URL_PROD=postgres://USER:PASS@222.128.65.91:25432/unfold_prod

# Meilisearch（已部署，生产模式；除 /health 外均需 Bearer）
MEILI_URL=http://222.128.65.91:7700
MEILI_SEARCH_KEY=
MEILI_ADMIN_KEY=

# Qdrant（阶段 0 部署，docker run -p 6333:6333 qdrant/qdrant）
QDRANT_URL=http://222.128.65.91:6333
QDRANT_API_KEY=

# 阿里云百炼 DashScope（embedding / gte-rerank / qwen-plus 建议）。缺失时全部模型能力降级。
DASHSCOPE_API_KEY=

SESSION_SECRET=
UNFOLD_ENV=development
