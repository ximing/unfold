# Unfold server 环境变量（示例）。真实值见本目录 .env（不入库）。
# dev/test 同库（用户明确要求）；prod 用 unfold_prod。
DATABASE_URL=postgres://USER:PASS@222.128.65.91:25432/unfold_dev
DATABASE_URL_PROD=postgres://USER:PASS@222.128.65.91:25432/unfold_prod

# Meilisearch（已部署，生产模式；除 /health 外均需 Bearer）
MEILI_URL=http://222.128.65.91:7700
MEILI_SEARCH_KEY=
MEILI_ADMIN_KEY=

# Qdrant。应用连这个地址，当前部署端口是 16333。
QDRANT_URL=http://222.128.65.91:16333
QDRANT_API_KEY=

# 阿里云百炼 DashScope。缺 key 或 base URL 时跳过 embedding、精排和模型建议。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSIONS=2560
RERANK_MODEL=qwen3.7-text-rerank
# 设为 off 时不调用建议模型。未设置且上面的 key 与 base URL 都在时会调用 qwen-plus。
UNFOLD_SUGGEST_MODEL=

SESSION_SECRET=
UNFOLD_ENV=development

# 本地种子账号。密码留空，不要写入真实口令。
SEED_USERNAME=unfold
SEED_PASSWORD=
