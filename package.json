{
  "name": "unfold",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @unfold/server --filter @unfold/web dev",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.31.3",
      "@tiptap/pm": "3.31.3",
      "@tiptap/html": "3.31.3",
      "@tiptap/starter-kit": "3.31.3",
      "@tiptap/react": "3.31.3"
    }
  }
}
